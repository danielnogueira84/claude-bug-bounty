# Sensitive output — never commit these
findings/
recon/
reports/
hunt-memory/
config.json
*.burp
*.json.bak

# API keys and tokens
.env
secrets.txt
api_keys.txt
.private/

# Nested local clones / sub-repos (not tracked)
claude-bug-bounty/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# macOS
.DS_Store
.AppleDouble

# Logs
*.log
*.txt.bak

# Tool output
*.out
nmap-output/
.atlas/
.forge/

# Account vault — real test-identity creds NEVER belong in git.
# (Real vaults live outside the repo in Claude's project memory dir; this is a safety net.)
memory/accounts/
accounts/*.json
!tools/account_vault.example.json
